# Common: replace placeholders for your onboarded subscription and supported placement.
subscription_id   = "00000000-0000-0000-0000-000000000000"
location          = "<azure-region>"
availability_zone = "<supported-logical-zone>"
tags = {
  workload = "oradb"
}

# Resource Group: default owns the entire new chain in one state.
create_resource_group = true
resource_group_name   = "rg-oradb-anchored"

# Existing Anchors: null creates the full chain; set lookup objects to reuse.
# Reuse requires create_resource_group=false and resource_group_name="<anchor-group>".
# All anchors, networking, infrastructure and VM cluster share this group and one RA.
existing_resource_anchor = null
existing_network_anchor  = null
# Existing NA example: RA is discovered from its properties, without copied IDs.
# existing_network_anchor = { name = "<network-anchor-name>", resource_group_name = "<anchor-group>" }
# Existing RA only: use the same existing group for the full chain.
# existing_resource_anchor = { name = "<resource-anchor-name>", resource_group_name = "<anchor-group>" }

# New Anchors: names/settings are ignored for anchors selected for reuse.
resource_anchor_name  = "oradb-resource-anchor"
network_anchor_name   = "oradb-network-anchor"
oci_vcn_dns_label     = "oradb"
oci_backup_cidr_block = "192.168.252.0/24"
dns                   = {}

# Networking for a NEW Network Anchor. Leave existing_subnet_id null to create.
# Reusing an existing Network Anchor discovers its networking; do not supply a subnet.
existing_subnet_id              = null
virtual_network_name            = "vnet-oradb-anchored"
virtual_network_address_space   = ["10.20.0.0/16"]
delegated_subnet_name           = "snet-oradb"
delegated_subnet_address_prefix = "10.20.1.0/24"

# Exadata Infrastructure: new paid dedicated capacity in every supported mode.
infrastructure = {
  name  = "oradb-infra"
  shape = "<available-exadata-shape>"
  # For X11M-family shapes, set both types from target-region flexComponents metadata.
  # database_server_type = "<supported-database-server-type>"
  # storage_server_type  = "<supported-storage-server-type>"
  compute_count = 2
  storage_count = 3
}

# VM Cluster: illustrative allocations, confirm shape/server-specific sizing.
vm_cluster_name             = "oradb-vmcluster"
hostname                    = "<short-hostname-prefix>"
gi_version                  = "<available-gi-version>"
ssh_public_keys             = ["<your-rsa-openssh-public-key>"]
cpu_core_count              = 4
memory_size_in_gbs          = 256
db_node_storage_size_in_gbs = 256
data_storage_size_in_tbs    = 2
data_storage_percentage     = 80
license_model               = "BringYourOwnLicense"
time_zone                   = "UTC"
is_local_backup_enabled     = false
is_sparse_diskgroup_enabled = false

# Automatic discovery occurs AFTER infrastructure provisioning; select first two
# sorted OCI DB server IDs. Pin output IDs here before any infrastructure edit, including tags.
db_servers      = null
db_server_count = 2
data_collection_options = {
  diagnostics_events_enabled = false
  health_monitoring_enabled  = false
  incident_logs_enabled      = false
}
