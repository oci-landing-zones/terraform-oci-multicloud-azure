# Common
subscription_id   = "00000000-0000-0000-0000-000000000000"
location          = "<azure-region>"
availability_zone = "<supported-logical-zone>"
tags = {
  workload = "oradb"
}

# Resource Group: reuse the group containing both existing anchors.
create_resource_group = false
resource_group_name   = "rg-oradb-workload"

# Anchors: replace with your existing anchors in the same resource group.
resource_anchor_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-oradb-workload/providers/Oracle.Database/resourceAnchors/oradb-resource-anchor"
network_anchor_id  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-oradb-workload/providers/Oracle.Database/networkAnchors/oradb-network-anchor"

# Exadata Infrastructure
existing_cloud_exadata_infrastructure_id = null
infrastructure = {
  name  = "oradb-infra"
  shape = "<available-exadata-shape>"
  # For X11M-family shapes, set both types from target-region flexComponents metadata.
  # database_server_type = "<supported-database-server-type>"
  # storage_server_type  = "<supported-storage-server-type>"
  compute_count = 2
  storage_count = 3
}

# VM Cluster
vm_cluster_name             = "oradb-vmcluster"
hostname                    = "<short-hostname-prefix>"
gi_version                  = "<available-gi-version>"
ssh_public_keys             = ["<your-rsa-openssh-public-key>"]
db_server_count             = 2
db_servers                  = null
cpu_core_count              = 4
memory_size_in_gbs          = 256
db_node_storage_size_in_gbs = 256
data_storage_size_in_tbs    = 2
data_storage_percentage     = 80
license_model               = "BringYourOwnLicense"
time_zone                   = "UTC"
is_local_backup_enabled     = false
is_sparse_diskgroup_enabled = false
data_collection_options = {
  diagnostics_events_enabled = false
  health_monitoring_enabled  = false
  incident_logs_enabled      = false
}
